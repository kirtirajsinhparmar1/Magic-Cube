# Magic-Cube visualization-only export: full GAGG + K9 geometry.
# This macro wraps the frozen detector geometry; it does not redefine it.
# GateMaterials.db and magiccube_geometry.mac are copied beside this file by the job.

/gate/geometry/setMaterialDatabase GateMaterials.db
/gate/world/geometry/setXLength 200.0 mm
/gate/world/geometry/setYLength 200.0 mm
/gate/world/geometry/setZLength 200.0 mm
/gate/world/setMaterial Air
/control/execute magiccube_geometry.mac

# Visualization attributes only. Opaque colors are used for broad VRML compatibility.
/gate/world/vis/setVisible 0
/gate/magicCubeMother/vis/setVisible 0

/gate/mc_gagg_ee/vis/setColor red
/gate/mc_gagg_ee/vis/forceSolid
/gate/mc_gagg_ee/vis/setVisible 1
/gate/mc_gagg_eo/vis/setColor red
/gate/mc_gagg_eo/vis/forceSolid
/gate/mc_gagg_eo/vis/setVisible 1
/gate/mc_gagg_oe/vis/setColor red
/gate/mc_gagg_oe/vis/forceSolid
/gate/mc_gagg_oe/vis/setVisible 1
/gate/mc_gagg_oo/vis/setColor red
/gate/mc_gagg_oo/vis/forceSolid
/gate/mc_gagg_oo/vis/setVisible 1

/gate/mc_k9_ee/vis/setColor blue
/gate/mc_k9_ee/vis/forceSolid
/gate/mc_k9_ee/vis/setVisible 1
/gate/mc_k9_eo/vis/setColor blue
/gate/mc_k9_eo/vis/forceSolid
/gate/mc_k9_eo/vis/setVisible 1
/gate/mc_k9_oe/vis/setColor blue
/gate/mc_k9_oe/vis/forceSolid
/gate/mc_k9_oe/vis/setVisible 1
/gate/mc_k9_oo/vis/setColor blue
/gate/mc_k9_oo/vis/forceSolid
/gate/mc_k9_oo/vis/setVisible 1

# Geant4 11 ordering: initialize geometry before opening the viewer.
/gate/run/initialize
/vis/open VRML2FILE
/vis/viewer/set/viewpointThetaPhi 60 60
/vis/viewer/zoom 1.5
/vis/drawVolume
/vis/viewer/flush

