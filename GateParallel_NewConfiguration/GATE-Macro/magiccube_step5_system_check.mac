# Bounded Step-5 production-system compatibility check.
# This macro is for the user's later manual run only.

/gate/geometry/setMaterialDatabase GateMaterials.db

/gate/world/geometry/setXLength 200.0 mm
/gate/world/geometry/setYLength 200.0 mm
/gate/world/geometry/setZLength 200.0 mm
/gate/world/setMaterial Air

/control/execute magiccube_production_geometry.mac
/control/execute magiccube_production_system.mac
/control/execute magiccube_production_physics.mac

/gate/run/initialize

/control/execute magiccube_production_digitizer.mac

/gate/source/addSource step5_system_smoke gps
/gate/source/step5_system_smoke/gps/particle gamma
/gate/source/step5_system_smoke/gps/pos/type Point
/gate/source/step5_system_smoke/gps/pos/centre 0.0 0.0 -66.0 mm
/gate/source/step5_system_smoke/gps/ang/type iso
/gate/source/step5_system_smoke/gps/ene/type Mono
/gate/source/step5_system_smoke/gps/ene/mono 140.0 keV
/gate/source/step5_system_smoke/setActivity 20000.0 becquerel

/gate/random/setEngineName MersenneTwister
/gate/application/setTimeStart 0.0 s
/gate/application/setTimeStop 1.0 s
/gate/application/setTimeSlice 1.0 s

/gate/output/tree/enable
/gate/output/tree/addFileName /vscratch/grp-rutaoyao/Kirtiraj/Magic Cube/runtime_validation/step5_system/magiccube_step5_system.root
/gate/output/tree/hits/enable
/gate/output/tree/addCollection Singles

/gate/application/startDAQ
