# Magic-Cube production ROOT output
# Faithful output/tree mechanism from the active original output.mac.

/gate/output/tree/enable
/gate/output/tree/addFileName ./magiccube_production.root
/gate/output/tree/hits/enable

# The frozen Magic-Cube digitizer owns one Singles collection per GAGG family.
/gate/output/tree/addCollection Singles_mc_gagg_ee
/gate/output/tree/addCollection Singles_mc_gagg_eo
/gate/output/tree/addCollection Singles_mc_gagg_oe
/gate/output/tree/addCollection Singles_mc_gagg_oo
