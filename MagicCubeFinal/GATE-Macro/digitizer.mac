# Magic-Cube Step 5B: faithful port of the active original digitizer.mac.
# The validated Magic-Cube system uses ordinary attachCrystalSD on four named
# GAGG families, so the original per-xlayer manager paths are adapted to the
# corresponding four GAGG volume names.  Module order and values are unchanged.

# mc_gagg_ee
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/insert adder
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/insert energyResolution
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/energyResolution/fwhm 0.10
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/energyResolution/energyOfReference 140. keV
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/insert spatialResolution
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/spatialResolution/fwhm 1.0 mm
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/spatialResolution/confineInsideOfSmallestElement true
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/spatialResolution/verbose 0
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/insert energyFraming
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/energyFraming/setMin 120. keV
/gate/digitizerMgr/mc_gagg_ee/SinglesDigitizer/Singles/energyFraming/setMax 160. keV

# mc_gagg_eo
/gate/digitizerMgr/mc_gagg_eo/SinglesDigitizer/Singles/insert adder
